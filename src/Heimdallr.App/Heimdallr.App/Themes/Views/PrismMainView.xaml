                  ToolTip="ArrowDownBold" />
              </StackPanel>

              <ctrls:HeimdallrScrollBar
                Grid.Column="4"
                Width="200"
                Height="20"
                Margin="10,0,0,0"
                IconMouseOverFill="Red"
                Orientation="Horizontal"
                ToolTip="ScrollBar" />

              <ctrls:HeimdallrScrollBar
                Grid.Column="5"
                Height="100"
                Margin="10,0,0,0"
                IconMouseOverFill="Red"
                Orientation="Vertical"
                ToolTip="ScrollBar" />

              <ctrls:HeimdallrTreeView
                Grid.Column="6"
                Width="200"
                Background="Transparent"
                ToolTip="TreeView">
                <ctrls:HeimdallrTreeViewItem
                  CollapseIcon="Arrow_Triangle_Up"
                  ExpandIcon="Arrow_Ellipse_DownA"
                  ExpandToggleIconSize="15"
                  FontSize="10"
                  Foreground="Red"
                  Icon="Signature"
                  SelectedBackground="AliceBlue"
                  ToolTip="TreeViewItem">

                  <ctrls:HeimdallrTreeViewItem
                    CollapseIcon="Arrow_Triangle_Up"
                    CollapseIconFill="Bisque"
                    CommandParameter="없음"
                    ExpandIcon="Arrow_Ellipse_DownA"
                    ExpandIconFill="AliceBlue"
                    ExpandToggleIconSize="10"
                    Icon="Create"
                    IconSize="20"
                    SelectedCommand="{Binding MessageCommand}"
                    Text="등록">

                    <!--  하위 아이템: 세부정보  -->
                    <ctrls:HeimdallrTreeViewItem
                      CommandParameter="없음"
                      Foreground="Green"
                      Icon="Create"
                      IconFill="AliceBlue"
                      IconSize="16"
                      SelectedCommand="{Binding MessageCommand}"
                      Text="세부정보" />

                    <!--  또 다른 하위 아이템  -->
                    <ctrls:HeimdallrTreeViewItem
                      CommandParameter="없음"
                      Foreground="Blue"
                      Icon="Create"
                      IconFill="LightGreen"
                      IconSize="16"
                      SelectedCommand="{Binding MessageCommand}"
                      Text="추가정보" />
                  </ctrls:HeimdallrTreeViewItem>
                </ctrls:HeimdallrTreeViewItem>
              </ctrls:HeimdallrTreeView>

              <ctrls:HeimdallrListView
                Grid.Column="7"
                AlternationCount="100000"
                Background="Transparent"
                ColumnHeaderFontSize="18"
                ContextMenu="{StaticResource ContextMenu}"
                ItemFontSize="20"
                ItemForeground="Blue"
                ItemsSource="{Binding ListViewTest}"
                ScrollViewer.VerticalScrollBarVisibility="Auto">

                <ctrls:HeimdallrListView.View>
                  <GridView>

                    <GridViewColumn Width="40" Header="#">
                      <GridViewColumn.CellTemplate>
                        <DataTemplate>

                          <TextBlock HorizontalAlignment="Left" Text="{Binding RelativeSource={RelativeSource AncestorType=ctrls:HeimdallrListViewItem}, Path=(ItemsControl.AlternationIndex), Converter={convt:PlusOneConverter}}" />

                        </DataTemplate>
                      </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <GridViewColumn
                      Width="150"
                      exten:GridViewColumnExtensions.SortMemberPath="Name"
                      Header="이름">
                      <GridViewColumn.CellTemplate>
                        <DataTemplate>

                          <TextBlock
                            HorizontalAlignment="Center"
                            FontSize="{Binding ItemFontSize, RelativeSource={RelativeSource AncestorType=ctrls:HeimdallrListView}}"
                            Foreground="{Binding ItemForeground, RelativeSource={RelativeSource AncestorType=ctrls:HeimdallrListView}}"
                            Text="{Binding Name}" />

                        </DataTemplate>
                      </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <GridViewColumn
                      Width="100"
                      exten:GridViewColumnExtensions.SortMemberPath="Age"
                      Header="나이">
                      <GridViewColumn.CellTemplate>
                        <DataTemplate>

                          <TextBlock
                            HorizontalAlignment="Center"
                            FontSize="{Binding ItemFontSize, RelativeSource={RelativeSource AncestorType=ctrls:HeimdallrListView}}"
                            Foreground="{Binding ItemForeground, RelativeSource={RelativeSource AncestorType=ctrls:HeimdallrListView}}"
                            Text="{Binding Age}" />

                        </DataTemplate>
                      </GridViewColumn.CellTemplate>
                    </GridViewColumn>


                    <GridViewColumn
                      Width="150"
                      exten:GridViewColumnExtensions.SortMemberPath="Department"
                      Header="부서">
                      <GridViewColumn.CellTemplate>
                        <DataTemplate>

                          <TextBlock
                            HorizontalAlignment="Center"
                            FontSize="{Binding ItemFontSize, RelativeSource={RelativeSource AncestorType=ctrls:HeimdallrListView}}"
                            Foreground="{Binding ItemForeground, RelativeSource={RelativeSource AncestorType=ctrls:HeimdallrListView}}"
                            Text="{Binding Department}" />

                        </DataTemplate>
                      </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                  </GridView>
                </ctrls:HeimdallrListView.View>

              </ctrls:HeimdallrListView>
            </Grid>

            <Grid Grid.Row="3">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>

              <StackPanel
                Grid.Column="0"
                Margin="10,0,0,0"
                Orientation="Horizontal">
                <TextBox
                  Width="200"
                  Height="36"
                  Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                <ItemsControl ItemsSource="{Binding NameErrors}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Foreground="Red" Text="{Binding}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button
                  Width="100"
                  Height="36"
                  Content="Submit"
                  IsEnabled="{Binding HasErrorsBindable, Converter={convt:InverseBooleanConverter}}" />
              </StackPanel>

              <ctrls:HeimdallrPlaceholderPasswordBox
                Grid.Column="1"
                Margin="10,0,0,0"
                EyeIcon="Key"
                Foreground="#FFFFFFFF"
                Icon="Address"
                Password="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                PlaceholderForeground="AliceBlue"
                PlaceholderText="비밀번호를 입력하세요"
                RightIconToolTip="비밀번호 보기" />

              <StackPanel
                Grid.Column="2"
                Margin="10,0,0,0"
                Orientation="Horizontal">
                <ctrls:HeimdallrSlider
                  Margin="10,0,0,0"
                  LargeChange="10"
                  Maximum="100"
                  Minimum="0"
                  SmallChange="1"
                  ToolTip="Slider"
                  Value="{Binding SliderValue, Mode=TwoWay}" />
                <TextBlock VerticalAlignment="Center" Text="{Binding DisplayText}" />
              </StackPanel>

              <ctrls:HeimdallrThemeSwitchToggleButton Grid.Column="3" IsChecked="{Binding IsLoading, Mode=TwoWay}" />

              <ctrls:HeimdallrDatePicker
                Grid.Column="4"
                Margin="10,0,0,0"
                HorizontalOffset="-30"
                SelectedDate="{Binding HireDay, UpdateSourceTrigger=PropertyChanged}"
                Watermark="바인딩안됨" />
            </Grid>


            <ctrls:HeimdallrGroupBox
              Grid.Row="4"
              BorderBrush="Green"
              CornerRadius="7"
              Header="그룹박스일가요"
              HeaderFontSize="20"
              HeaderFontWeight="ExtraLight"
              HeaderForeground="Red"
              Icon="Menu"
              IconFill="Orange"
              IconSize="16"
              IsCollapsible="True">
              <!--  ViewModelBase 메서드 테스트  -->
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ctrls:HeimdallrPlaceholderTextBox
                  Grid.Column="0"
                  BorderBrush="AliceBlue"
                  Foreground="#FFFFFFFF"
                  Icon="ActiveB"
                  IsFloatingLabel="True"
                  PlaceholderForeground="AliceBlue"
                  PlaceholderText="테스트입니다."
                  RightCommand="{Binding MessageCommand}"
                  RightIcon="ActiveB"
                  RightIconFill="Azure"
                  RightIconToolTip="ViewModelBase 테스트"
                  Text="{Binding ViewModel, UpdateSourceTrigger=PropertyChanged}" />

                <Label
                  Name="ErrorLabel"
                  Grid.Column="1"
                  Margin="5,0,0,0"
                  Content="{Binding NameErrorsText}"
                  Foreground="Red" />

                <StackPanel
                  Grid.Column="2"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Orientation="Horizontal">

                  <!--  MVVM 버튼 1  -->
                  <Button
                    Width="120"
                    Height="50"
                    he:FocusVisualHelper.FocusVisualMargin="{Binding ButtonFocusMargin}"
                    he:FocusVisualHelper.FocusVisualPrimaryBrush="{Binding ButtonPrimaryBrush}"
                    he:FocusVisualHelper.FocusVisualPrimaryThickness="{Binding ButtonPrimaryThickness}"
                    he:FocusVisualHelper.FocusVisualSecondaryBrush="{Binding ButtonSecondaryBrush}"
                    he:FocusVisualHelper.FocusVisualSecondaryThickness="{Binding ButtonSecondaryThickness}"
                    he:FocusVisualHelper.IsTemplateFocusTarget="{Binding IsTemplateFocusTarget}"
                    he:FocusVisualHelper.UseSystemFocusVisuals="{Binding UseSystemFocusVisuals}"
                    Command="{Binding ButtonClickCommand}"
                    CommandParameter="MVVM 버튼 1"
                    Content="MVVM 버튼 1" />

                  <!--  MVVM 버튼 2  -->
                  <Button
                    Width="120"
                    Height="50"
                    he:FocusVisualHelper.FocusVisualMargin="{Binding ButtonFocusMargin}"
                    he:FocusVisualHelper.FocusVisualPrimaryBrush="{Binding ButtonPrimaryBrush}"
                    he:FocusVisualHelper.FocusVisualPrimaryThickness="{Binding ButtonPrimaryThickness}"
                    he:FocusVisualHelper.FocusVisualSecondaryBrush="{Binding ButtonSecondaryBrush}"
                    he:FocusVisualHelper.FocusVisualSecondaryThickness="{Binding ButtonSecondaryThickness}"
                    he:FocusVisualHelper.IsTemplateFocusTarget="{Binding IsTemplateFocusTarget}"
                    he:FocusVisualHelper.UseSystemFocusVisuals="{Binding UseSystemFocusVisuals}"
                    Command="{Binding ButtonClickCommand}"
                    CommandParameter="MVVM 버튼 2"
                    Content="MVVM 버튼 2" />

                  <Path Data="M15.41,16.58L10.83,12L15.41,7.41L14,6L8,12L14,18L15.41,16.58Z" Fill="#FFFFFFFF" />

                  <Path Data="M8.59,16.58L13.17,12L8.59,7.41L10,6L16,12L10,18L8.59,16.58Z" Fill="#FFFFFFFF" />

                  <ctrls:HeimdallrDatePicker
                    KeepPopupOpen="False"
                    PopupBackground="#FF456882"
                    SelectedDate="{Binding HireDay, UpdateSourceTrigger=PropertyChanged}"
                    ToolTip="만든일자"
                    VerticalOffset="0"
                    Watermark="바인딩오류" />

                  <!--  Determinate, 단색, Glow 적용  -->
                  <ctrls:HeimdallrProgressBar
                    Margin="10,0,0,0"
                    Background="{DynamicResource DarkPlum}"
                    Fill="LightSkyBlue"
                    IsProgressTextVisible="True"
                    Maximum="{Binding Maximum}"
                    Minimum="{Binding Minimum}"
                    ProgressTextForeground="Yellow"
                    ToolTip="PregressBar"
                    Value="{Binding Value}" />



                </StackPanel>
              </Grid>
            </ctrls:HeimdallrGroupBox>

            <!--#region AnimatedContentMenu Row 0-->
            <Grid Grid.Row="5">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>

              <!--  열기/닫기 버튼  -->
              <Button
                Grid.Column="1"
                Width="100"
                Height="30"
                Margin="10"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Command="{Binding ToggleMenuCommand}"
                Content="Toggle Menu" />

              <ctrls:AnimatedContentMenu
                Grid.Column="0"
                Padding="5"
                HorizontalAlignment="Right"
                Background="#FF456882"
                EasingMode="BackEaseIn"
                IsOpen="{Binding MenuVisible}"
                OpenCloseDuration="0:0:1"
                OverlayMode="Push"
                SlideDirection="Left">

                <ctrls:AnimatedContentMenu.Content>
                  <Grid>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ListBox
                      Grid.Row="0"
                      Background="Transparent"
                      BorderThickness="0"
                      ItemsSource="{Binding MenuItems}">
                      <ListBox.ItemTemplate>
                        <DataTemplate>
                          <StackPanel>

                            <!--  상위 메뉴 RadioButton  -->
                            <ctrls:HeimdallrRadioButton
                              Margin="5,10,0,0"
                              HorizontalContentAlignment="Left"
                              Content="{Binding Title}"
                              FontSize="18"
                              Foreground="White"
                              GroupName="MainMenu"
                              IsChecked="{Binding IsChecked, Mode=TwoWay}">
                              <ctrls:HeimdallrRadioButton.InputBindings>
                                <MouseBinding
                                  Command="{Binding RelativeSource={RelativeSource AncestorType=ListBox}, Path=DataContext.ToggleSubMenuCommand}"
                                  CommandParameter="{Binding}"
                                  MouseAction="LeftClick" />
                              </ctrls:HeimdallrRadioButton.InputBindings>
                            </ctrls:HeimdallrRadioButton>

                            <!--  하위 메뉴 ItemsControl  -->
                            <ItemsControl ItemsSource="{Binding SubItems}">
                              <ItemsControl.Style>
                                <Style TargetType="ItemsControl">
                                  <Setter Property="Visibility" Value="Collapsed" />
                                  <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                      <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </ItemsControl.Style>
                              <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                  <ctrls:HeimdallrRadioButton
                                    Margin="20,5,0,5"
                                    HorizontalContentAlignment="Left"
                                    Content="{Binding Title}"
                                    FontSize="16"
                                    Foreground="LightGray"
                                    GroupName="SubMenu"
                                    IsChecked="{Binding IsChecked, Mode=TwoWay}" />
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </StackPanel>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                    <ctrls:HeimdallrRadioButton
                      Grid.Row="2"
                      Content="라디오홈버튼"
                      Icon="Address"
                      IconFill="AliceBlue" />
                  </Grid>
                </ctrls:AnimatedContentMenu.Content>
              </ctrls:AnimatedContentMenu>

              <ctrls:HeimdallrDropdownContentMenu
                x:Name="MyDropdown"
                Grid.Column="2"
                Width="200"
                VerticalAlignment="Top"
                HorizontalOffset="-20"
                Icon="Menu"
                IconSize="15"
                IsOpen="{Binding MenuVisible}"
                Label="옵션선택"
                VerticalOffset="-10">
                <ctrls:HeimdallrDropdownContentMenu.Content>
                  <StackPanel>
                    <ctrls:HeimdallrFlatButton
                      Margin="2"
                      Command="{Binding MessageCommand}"
                      Content="메뉴 항목 1" />
                    <ctrls:HeimdallrFlatButton
                      Margin="2"
                      Command="{Binding MessageCommand}"
                      Content="메뉴 항목 2" />
                    <ctrls:HeimdallrFlatButton
                      Margin="2"
                      Command="{Binding MessageCommand}"
                      Content="메뉴 항목 3" />
                    <ctrls:HeimdallrFlatButton
                      Margin="2"
                      Command="{Binding MessageCommand}"
                      Content="메뉴 항목 4" />
                    <ctrls:HeimdallrFlatButton
                      Margin="2"
                      Command="{Binding MessageCommand}"
                      Content="메뉴 항목 5" />
                    <ctrls:HeimdallrFlatButton
                      Margin="2"
                      Command="{Binding MessageCommand}"
                      Content="메뉴 항목 6" />
                  </StackPanel>
                </ctrls:HeimdallrDropdownContentMenu.Content>
              </ctrls:HeimdallrDropdownContentMenu>

              <!--  슬라이드 메뉴  -->
              <ctrls:HeimdallrSlideContentPanel
                x:Name="SlideMenu"
                Grid.Column="3"
                Margin="5"
                Background="#FF2B2B2B"
                BorderBrush="#FF555555"
                BorderThickness="1"
                IsOpen="{Binding IsOpen, Mode=TwoWay}"
                ToolTip="SlideContentPanel">
                <ctrls:HeimdallrSlideContentPanel.Content>

                  <StackPanel>
                    <ctrls:HeimdallrRadioButton
                      Margin="2"
                      Command="{Binding MessageCommand}"
                      Content="슬라이드메뉴항목 1"
                      Icon="Account" />
                    <ctrls:HeimdallrRadioButton
                      Margin="2"
                      Command="{Binding MessageCommand}"
                      Content="슬라이드메뉴항목 2"
                      Icon="AccountA" />
                    <ctrls:HeimdallrRadioButton
                      Margin="2"
                      Command="{Binding MessageCommand}"
                      Content="메뉴 항목5"
                      Icon="AccountBox" />
                  </StackPanel>

                </ctrls:HeimdallrSlideContentPanel.Content>
              </ctrls:HeimdallrSlideContentPanel>

              <!--  메뉴 열기 버튼  -->
              <ctrls:HeimdallrSwitchCheckBox
                Grid.Column="4"
                Width="120"
                Margin="10,0,0,0"
                Icon="Menu"
                IconMouseOverFill="Purple"
                IsChecked="{Binding IsOpen, Mode=TwoWay}"
                OffLabel="슬라이드OFF"
                OffLebelForeground="#FF8C3061"
                OnLabel="슬라이드ON"
                OnLebelForeground="#FFFFFFFF" />

              <ctrls:HeimdallrDatePicker
                Grid.Column="5"
                Margin="10,0,0,0"
                SelectedDate="{Binding HireDay, UpdateSourceTrigger=PropertyChanged}" />

              <DatePicker
                Grid.Column="6"
                Width="120"
                Height="30"
                Margin="10,0,0,0"
                Background="Yellow" />

            </Grid>
            <!--#endregion-->

            <Grid Grid.Row="6">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>

              <TextBlock
                Grid.Column="0"
                FontSize="20"
                Foreground="Red"
                Text="{Binding BusyMessage, UpdateSourceTrigger=PropertyChanged}" />

              <Grid Grid.Column="1">
                <StackPanel Orientation="Horizontal">
                  <ctrls:HeimdallrIcon
                    Fill="White"
                    Icon="Read"
                    IconSize="30" />
                </StackPanel>
              </Grid>
            </Grid>



          </Grid>
        </ctrls:HeimdallrScrollViewer>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>