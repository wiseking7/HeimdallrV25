<ResourceDictionary
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:convt="clr-namespace:Heimdallr.UI.Converters;assembly=Heimdallr.UI"
  xmlns:ctrls="clr-namespace:Heimdallr.UI.Controls;assembly=Heimdallr.UI"
  xmlns:exten="clr-namespace:Heimdallr.UI.Extensions;assembly=Heimdallr.UI"
  xmlns:he="clr-namespace:Heimdallr.UI.Helpers;assembly=Heimdallr.UI"
  xmlns:ui="clr-namespace:Heimdallr.App.Themes.UI">



  <!--#region ListView 컨텍스트 메뉴(비밀번호 변경, 복원, 삭제)-->
  <ctrls:HeimdallrContextMenu
    x:Key="ContextMenu"
    BackgroundColor="AliceBlue"
    DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
    <!--#region 비밀번호 변경 컨텍스트 메뉴-->
    <ctrls:HeimdallrMenuItem
      Margin="10,5"
      Command="{Binding MessageCommand}"
      CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
      FontSize="16"
      Header="비밀번호변경"
      Icon="Exchange"
      IconFill="#FFFDCFFA"
      IconSize="15"
      ToolTip="비밀번호변경" />
    <!--#endregion-->

    <!--#region 복원 컨텍스트 메뉴 (IsActive(bool), IsLocked(bool), FailedLoginAttempts(int)-->
    <ctrls:HeimdallrMenuItem
      Margin="10,5"
      Command="{Binding MessageCommand}"
      CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
      FontSize="16"
      Header="복원"
      Icon="AccountA"
      IconFill="#FF739EC9"
      IconSize="15"
      ToolTip="복원" />
    <!--#endregion-->

    <!--#region 삭제-->
    <ctrls:HeimdallrMenuItem
      Margin="10,5"
      Command="{Binding MessageCommand}"
      CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
      FontSize="16"
      Header="삭제"
      Icon="Delete"
      IconSize="15"
      MenuItemIsMouseOverBrush="Red"
      ToolTip="삭제" />
    <!--#endregion-->
  </ctrls:HeimdallrContextMenu>
  <!--#endregion-->


  <Style BasedOn="{StaticResource {x:Type ctrls:BaseThemeWindow}}" TargetType="{x:Type ui:PrismMainView}">

    <Setter Property="Background" Value="{DynamicResource WindowBackgroundColor}" />

    <Setter Property="HeaderBackground" Value="{DynamicResource TitleHeaderBackground}" />
    <Setter Property="HeaderContent">
      <Setter.Value>
        <StackPanel Orientation="Horizontal">
          <ctrls:HeimdallrFlatButton
            x:Name="FlatButton"
            Margin="5,0"
            Background="Transparent"
            Content="설정"
            CornerRadius="7"
            ToolTip="설정">
            <ctrls:HeimdallrFlatButton.ContextMenu>
              <ctrls:HeimdallrContextMenu>

                <ctrls:HeimdallrMenuItem
                  Command="{Binding MessageCommand}"
                  Header="일반 설정"
                  Icon="Setting"
                  IconFill="#FFFFFFFF"
                  MenuItemIsMouseOverBrush="Red"
                  ToolTip="일반설정" />

                <ctrls:HeimdallrMenuItem
                  Command="{Binding OpenDialogCommand}"
                  CommandParameter="Advanced"
                  Header="다이얼로그 데스트 열기 "
                  Icon="Broadcast"
                  IconFill="#FFFFFFFF"
                  ToolTip="다이얼로그 테스트 열기" />

                <ctrls:HeimdallrMenuItem
                  Command="{Binding MessageCommand}"
                  Header="비활성 메뉴"
                  Icon="Lock"
                  IconFill="#FFFFFFFF"
                  IsEnabled="False"
                  ToolTip="비횔성 메뉴" />
              </ctrls:HeimdallrContextMenu>
            </ctrls:HeimdallrFlatButton.ContextMenu>
          </ctrls:HeimdallrFlatButton>

          <ctrls:HeimdallrFlatButton
            x:Name="DimmingButton"
            Margin="5,0"
            Background="Transparent"
            Content="다이밍설정"
            CornerRadius="7"
            ToolTip="다이밍설정">
            <ctrls:HeimdallrFlatButton.ContextMenu>
              <ctrls:HeimdallrContextMenu Visibility="{Binding IsVisible, Converter={convt:BooleanToVisibilityConverter}}">
                <!--  다이밍 색상 선택 메뉴  -->
                <ctrls:HeimdallrMenuItem
                  Command="{Binding ChangeDimmingColorCommand}"
                  CommandParameter="#FF141414"
                  Header="다크"
                  Icon="Setting"
                  IconFill="#FF000000"
                  ToolTip="다크입니다" />
                <ctrls:HeimdallrMenuItem
                  Command="{Binding ChangeDimmingColorCommand}"
                  CommandParameter="#FFF5F5F5"
                  Header="라이트"
                  Icon="Broadcast"
                  IconFill="#FFFFFFFF"
                  ToolTip="라이트" />
                <ctrls:HeimdallrMenuItem
                  Command="{Binding ChangeDimmingColorCommand}"
                  CommandParameter="#FFFFA500"
                  Header="커스텀"
                  Icon="Lock"
                  IconFill="#FFFFA500"
                  ToolTip="커스텀" />

                <!--  다이밍 ON/OFF 토글  -->
                <Separator />
                <ctrls:HeimdallrMenuItem
                  Command="{Binding ToggleDimmingCommand}"
                  Header="다이밍 토글"
                  Icon="Power"
                  IconFill="#FFFFFFFF"
                  ToolTip="다이밍 토글" />
              </ctrls:HeimdallrContextMenu>
            </ctrls:HeimdallrFlatButton.ContextMenu>
          </ctrls:HeimdallrFlatButton>

          <!--  테마 설정 버튼  -->
          <ctrls:HeimdallrFlatButton
            x:Name="ThemeButton"
            Margin="5,0"
            Background="Transparent"
            Content="테마설정"
            CornerRadius="7"
            ToolTip="테마설정">
            <ctrls:HeimdallrFlatButton.ContextMenu>
              <ctrls:HeimdallrContextMenu>
                <ctrls:HeimdallrMenuItem
                  Command="{Binding ChangeThemeCommand}"
                  CommandParameter="Light"
                  Header="라이트 테마"
                  Icon="Date"
                  IconFill="#FFFFA500"
                  ToolTip="라이드테마" />
                <ctrls:HeimdallrMenuItem
                  Command="{Binding ChangeThemeCommand}"
                  CommandParameter="Dark"
                  Header="다크 테마"
                  Icon="Magnify"
                  IconFill="#FF555555"
                  ToolTip="다크테마" />
              </ctrls:HeimdallrContextMenu>
            </ctrls:HeimdallrFlatButton.ContextMenu>
          </ctrls:HeimdallrFlatButton>

          <!--  글자색 바인딩  -->
          <TextBlock
            Margin="0,0,0,10"
            FontSize="18"
            Foreground="{DynamicResource FontColor}"
            Text="Hello, Theme!" />

          <!--  ProgressBar 바인딩  -->
          <ProgressBar
            Width="200"
            Height="20"
            Background="{DynamicResource BackgroundColor}"
            Foreground="{DynamicResource SliderBrush}"
            Maximum="100"
            Minimum="0"
            Value="50" />

        </StackPanel>
      </Setter.Value>
    </Setter>

