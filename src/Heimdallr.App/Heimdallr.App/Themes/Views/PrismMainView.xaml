                PlaceholderText="입력하세요"
                RightIcon="User"
                RightIconToolTip="테스트"
                ToolTip="PlaceHolderTextbox" />

              <ctrls:HeimdallrHoldButton
                Grid.Column="3"
                Margin="10,0,0,0"
                AnimatedFillDuration="0:0:0.1"
                BackgroundRectangleFill="Beige"
                ButtonText="OK"
                HoldDuration="0:0:1"
                Icon="Save"
                IsEnabled="False"
                ToolTip="HoldButton" />

              <ctrls:HeimdallrNumericButton
                Grid.Column="4"
                Margin="10,0,0,0"
                DownButtonIcon="Arrow_Ellipse_DownA"
                Max="1000"
                Min="-50"
                Step="50"
                ToolTip="NumericButton"
                UpButtonIcon="Arrow_Ellipse_UpA" />

              <ctrls:HeimdallrIcon
                Grid.Column="5"
                Margin="10,0,0,0"
                Command="{Binding HeimdallrPlaceholderTextBoxCommand}"
                Fill="Chartreuse"
                Icon="Sale"
                IconSize="50"
                ToolTip="HeimdallrIcon" />

              <ctrls:HeimdallrPlaceholderTextBox
                Grid.Column="6"
                Width="200"
                Margin="10,0,0,0"
                Foreground="#FFFFFFFF"
                Icon="ActiveB"
                IsFloatingLabel="True"
                PlaceholderForeground="AliceBlue"
                PlaceholderText="숫자만"
                RightCommand="{Binding MessageCommand}"
                RightIcon="ActiveB"
                RightIconFill="Azure"
                RightIconToolTip="자동코드생성"
                Text="{Binding Numeric, UpdateSourceTrigger=PropertyChanged, Converter={convt:NumericConverter}}"
                ToolTip="PlaceHolderTextBox" />

              <ctrls:HeimdallrPlaceholderTextBox
                Grid.Column="7"
                Width="200"
                Margin="10,0,0,0"
                Foreground="#FFFFFFFF"
                Icon="ActiveB"
                IsFloatingLabel="True"
