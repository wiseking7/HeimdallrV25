                ToolTip="PlaceHolderTextBox" />

              <ctrls:HeimdallrPlaceholderTextBox
                Grid.Column="9"
                Width="200"
                Margin="10,0,0,0"
                Foreground="#FFFFFFFF"
                Icon="ActiveB"
                IsFloatingLabel="True"
                PlaceholderForeground="AliceBlue"
