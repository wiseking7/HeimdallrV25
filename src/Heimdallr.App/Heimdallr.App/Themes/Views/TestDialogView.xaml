<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="https://Heimdallr.WPF.UI"
                    xmlns:ctrls="clr-namespace:Heimdallr.App.Themes.UI">

  <Style TargetType="{x:Type ctrls:TestDialogView}">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ctrls:TestDialogView}">
          <Border Background="{TemplateBinding Background}" 
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}">

            <Grid Background="Transparent">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>

              <!-- 메뉴 열기 버튼 -->
              <ui:HeimdallrSwitchCheckBox Grid.Column="0" Icon="Ghost1" Width="120" Margin="10 0 0 0"
                                           OnLabel="슬라이드ON" OffLabel="슬라이드OFF" OnLebelForeground="#FFFFFFFF"
                                           OffLebelForeground="#FF8C3061" IsChecked="{Binding IsOpen, Mode=TwoWay}"/>

              <ui:HeimdallrPlaceholderPasswordBox Grid.Column="1"  Foreground="#FFFFFFFF" Margin="10 0 0 0"
                                                  Icon="Address" Background="Black"
                                                  EyeIcon="Key"
                                                  RightIconToolTip="비밀번호 보기"
                                                  PlaceholderText="비밀번호를 입력하세요"
                                                  PlaceholderForeground="AliceBlue" 
                                                  />
            </Grid>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>