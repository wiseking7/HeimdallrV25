<ResourceDictionary
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:ctrls="clr-namespace:Heimdallr.UI.Controls">

  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/Heimdallr.UI;component/Styles/Colors/Color.xaml" />
  </ResourceDictionary.MergedDictionaries>

  <!--  HeimdallrIconToggleButton 스타일 정의 (팝업창이나 ContentMenu 외부 UI 열기)  -->
  <Style TargetType="{x:Type ctrls:HeimdallrIconToggleButton}">
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />

    <Setter Property="IconMouseOverFill" Value="#FFF7CE7C" />
    <Setter Property="IconFill" Value="#FFFFFFFF" />
    <Setter Property="IconCheckedFill" Value="#FF1690FA" />
    <Setter Property="IconDisabledFill" Value="#FFAEC2E4" />

    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ctrls:HeimdallrIconToggleButton}">

          <Border
            Name="border"
            Background="{TemplateBinding Background}"
            BorderBrush="Transparent"
            BorderThickness="{TemplateBinding BorderThickness}"
            CornerRadius="{TemplateBinding CornerRadius}"
            SnapsToDevicePixels="True">

            <Viewbox
              Width="{TemplateBinding IconSize}"
              Height="{TemplateBinding IconSize}"
              Margin="0,2,10,2"
              HorizontalAlignment="Center"
              VerticalAlignment="Center">
              <ctrls:HeimdallrIcon
                x:Name="icon"
                Fill="{Binding IconFill, RelativeSource={RelativeSource TemplatedParent}}"
                Icon="{Binding Icon, RelativeSource={RelativeSource TemplatedParent}}"
                IconMouseOverFill="{Binding IconMouseOverFill, RelativeSource={RelativeSource TemplatedParent}}"
                Stretch="Uniform" />
            </Viewbox>

          </Border>

          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="icon" Property="Fill" Value="{Binding IconMouseOverFill, RelativeSource={RelativeSource TemplatedParent}}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="icon" Property="Fill" Value="{Binding IconCheckedFill, RelativeSource={RelativeSource TemplatedParent}}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <!-- <Setter TargetName="border" Property="Background" Value="{StaticResource DarkGoldenrodBrush}"/>
                   <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource DarkMagentaBrush}"/>-->
              <Setter TargetName="icon" Property="Fill" Value="{Binding IconDisabledFill, RelativeSource={RelativeSource TemplatedParent}}" />
              <Setter Property="Opacity" Value="0.5" />
              <Setter Property="Foreground" Value="{StaticResource DarkCobaltBlue}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>