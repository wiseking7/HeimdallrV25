  <!--#region ThemeSwitchButton ToggleButton-->
  <Style TargetType="{x:Type ctrls:HeimdallrThemeSwitchToggleButton}">
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ctrls:HeimdallrThemeSwitchToggleButton}">
          <ControlTemplate.Resources>
            <Storyboard x:Key="SlideOut">
              <anima:ThicknessAnimationItem
                Mode="CubicEaseInOut"
                TargetName="cloud1"
                Property="Margin"
                To="-70 20 0 0"
                Duration="0:0:0.5" />
              <anima:ThicknessAnimationItem
                Mode="CubicEaseInOut"
                TargetName="cloud2"
                Property="Margin"
                To="-60 30 0 0"
                Duration="0:0:0.5" />
              <anima:ThicknessAnimationItem
                Mode="CubicEaseInOut"
                TargetName="cloud3"
                Property="Margin"
                To="135 20 0 0"
                Duration="0:0:0.5" />
              <anima:ThicknessAnimationItem
                Mode="CubicEaseInOut"
                TargetName="cloud4"
                Property="Margin"
                To="125 30 0 0"
                Duration="0:0:0.5" />
              <anima:ThicknessAnimationItem
                Mode="CubicEaseInOut"
                TargetName="ellipse"
                Property="Margin"
                To="74 4 4 4"
                Duration="0:0:0.5" />
              <anima:ThicknessAnimationItem
                Mode="CubicEaseInOut"
                TargetName="galaxy"
                Property="Margin"
                To="0 0 0 0"
                Duration="0:0:0.5" />
              <anima:ColorAnimationItem
                Mode="CubicEaseInOut"
                TargetName="ellipse"
                Property="(Fill).Color"
                To="#FFE5B91A"
                Duration="0:0:0.5" />
              <anima:ColorAnimationItem
                Mode="CubicEaseInOut"
                TargetName="border"
                Property="(Background).Color"
                To="#FF191C25"
                Duration="0:0:0.5" />
              <anima:DoubleAnimationItem
                Mode="CubicEaseInOut"
                TargetName="galaxy"
                Property="Opacity"
                To="1"
                Duration="0:0:0.5" />
            </Storyboard>

            <Storyboard x:Key="SlideIn">
              <anima:ThicknessAnimationItem
                Mode="CubicEaseInOut"
                TargetName="cloud1"
                Property="Margin"
                To="-10 20 0 0"
                Duration="0:0:0.5" />
              <anima:ThicknessAnimationItem
                Mode="CubicEaseInOut"
                TargetName="cloud2"
                Property="Margin"
                To="0 30 0 0"
                Duration="0:0:0.5" />
              <anima:ThicknessAnimationItem
                Mode="CubicEaseInOut"
                TargetName="cloud3"
                Property="Margin"
                To="65 20 0 0"
                Duration="0:0:0.5" />
              <anima:ThicknessAnimationItem
                Mode="CubicEaseInOut"
                TargetName="cloud4"
                Property="Margin"
                To="55 30 0 0"
                Duration="0:0:0.5" />
              <anima:ThicknessAnimationItem
                Mode="CubicEaseInOut"
                TargetName="ellipse"
                Property="Margin"
                To="4 4 4 4"
                Duration="0:0:0.5" />
              <anima:ThicknessAnimationItem
                Mode="CubicEaseInOut"
                TargetName="galaxy"
                Property="Margin"
                To="0 -60 0 0"
                Duration="0:0:0.5" />
              <anima:ColorAnimationItem
                Mode="CubicEaseInOut"
                TargetName="ellipse"
                Property="(Fill).Color"
                To="#FFFFB14F"
                Duration="0:0:0.5" />
              <anima:ColorAnimationItem
                Mode="CubicEaseInOut"
                TargetName="border"
                Property="(Background).Color"
                To="#FF4ED7F1"
                Duration="0:0:0.5" />
              <anima:DoubleAnimationItem
                Mode="CubicEaseInOut"
                TargetName="galaxy"
                Property="Opacity"
                To="0"
                Duration="0:0:0.5" />
            </Storyboard>
          </ControlTemplate.Resources>
          <Grid Style="{StaticResource RoundGridStyle}">
            <Border x:Name="border" Style="{StaticResource BorderStyle}" />
            <Control
              x:Name="cloud1"
              Margin="-10,20,0,0"
              Opacity="0.5"
              Style="{StaticResource CloundStyle}" />
            <Control
              x:Name="cloud2"
              Margin="0,30,0,0"
              Opacity="1.0"
              Style="{StaticResource CloundStyle}" />
            <Control
              x:Name="cloud3"
              Margin="65,20,0,0"
              Opacity="0.5"
              Style="{StaticResource CloundStyle}" />
            <Control
              x:Name="cloud4"
              Margin="55,30,0,0"
              Opacity="1.0"
              Style="{StaticResource CloundStyle}" />
            <Control
              x:Name="galaxy"
              Opacity="1.0"
              Style="{StaticResource GalaxyStyle}" />
            <Ellipse
              x:Name="ellipse"
              Margin="4"
              Style="{StaticResource EllipseStyle}" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard Storyboard="{StaticResource SlideOut}" />
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard Storyboard="{StaticResource SlideIn}" />
              </Trigger.ExitActions>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <!--#endregion-->
</ResourceDictionary>