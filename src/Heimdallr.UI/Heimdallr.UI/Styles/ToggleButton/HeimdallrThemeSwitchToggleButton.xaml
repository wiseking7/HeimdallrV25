<ResourceDictionary
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:anima="clr-namespace:Heimdallr.UI.Animations"
  xmlns:ctrls="clr-namespace:Heimdallr.UI.Controls">

  <!--#region Grid Style-->
  <Style x:Key="RoundGridStyle" TargetType="{x:Type Grid}">
    <Setter Property="Width" Value="120" />
    <Setter Property="Height" Value="50" />
    <Setter Property="Clip">
      <Setter.Value>
        <RectangleGeometry Rect="0 0 120 50">
          <RectangleGeometry.RadiusX>25</RectangleGeometry.RadiusX>
          <RectangleGeometry.RadiusY>25</RectangleGeometry.RadiusY>
        </RectangleGeometry>
      </Setter.Value>
    </Setter>
  </Style>
  <!--#endregion-->

  <!--#region Border Style-->
  <Style x:Key="BorderStyle" TargetType="{x:Type Border}">
    <Setter Property="Background" Value="#FF4ED7F1" />
  </Style>
  <!--#endregion-->

  <!--#region Ellipse Style-->
  <Style x:Key="EllipseStyle" TargetType="{x:Type Ellipse}">
    <Setter Property="Width" Value="42" />
    <Setter Property="Height" Value="42" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="Fill" Value="#FFFFB15F" />
  </Style>
  <!--#endregion-->

  <!--#region Open, Close-->
  <Style x:Key="EllipseWithTextStyle" TargetType="{x:Type Control}">
    <Setter Property="Width" Value="42" />
    <Setter Property="Height" Value="42" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Control">
          <Grid>
            <Ellipse x:Name="ellipseShape" Fill="#FFFFB15F" />
            <TextBlock
              x:Name="ellipseText"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              FontSize="12"
              FontWeight="Bold"
              Foreground="Black"
              Opacity="1"
              Text="Open" />
          </Grid>
          <ControlTemplate.Triggers>
            <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ctrls:HeimdallrThemeSwitchToggleButton}}" Value="True">
              <Setter TargetName="ellipseText" Property="Text" Value="Close" />
              <Setter TargetName="ellipseShape" Property="Fill" Value="#FFE5B91A" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ctrls:HeimdallrThemeSwitchToggleButton}}" Value="False">
              <Setter TargetName="ellipseText" Property="Text" Value="Open" />
              <Setter TargetName="ellipseShape" Property="Fill" Value="#FFFFB15F" />
            </DataTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <!--#endregion-->


  <!--#region Galaxy Sytle-->
  <!--
    여기서 Control 을 설정한 이유는 이 스타일이 어는 컨트롤에서 적용될지 명시(Control 타입이거나 그 하위 타입이니
    모든 컨트롤에 적용
  -->
