              Margin="48,6,31,43"
              Fill="#55FFFFFF" />
            <Rectangle
              Width="1"
              Height="1"
              Margin="68,30,11,19"
              Fill="#FFFFFF" />
            <Rectangle
              Width="1"
              Height="1"
              Margin="4,24,75,24"
              Fill="#55FFFFFF" />
            <Rectangle
              Width="1"
              Height="1"
              Margin="8,28,71,22"
              Fill="#55FFFFFF" />
            <Rectangle
              Width="1"
              Height="1"
              Margin="21,6,58,42"
              Fill="#55FFFFFF" />
            <Rectangle
              Width="1"
              Height="1"
              Margin="51,27,28,22"
              Fill="#55FFFFFF" />
            <Rectangle
              Width="1"
              Height="1"
              Margin="28,39,50,10"
              Fill="#55FFFFFF" />
            <Rectangle
              Width="1"
              Height="1"
              Margin="30,39,50,10"
              Fill="#55FFFFFF" />
            <Rectangle
              Width="1"
              Height="1"
              Margin="67,8,12,41"
              Fill="#55FFFFFF" />
            <Rectangle
              Width="1"
              Height="1"
              Margin="26,14,53,35"
              Fill="#55FFFFFF" />
            <Rectangle
              Width="1"
              Height="1"
              Margin="63,20,16,29"
              Fill="#55FFFFFF" />
            <Rectangle
              Width="1"
              Height="1"
              Margin="16,35,63,14"
              Fill="#55FFFFFF" />
            <Rectangle
              Width="1"
              Height="1"
              Margin="60,35,19,14"
              Fill="#55FFFFFF" />
            <Rectangle
              Width="1"
              Height="1"
              Margin="36,6,43,43"
              Fill="#FFFFFF" />
            <Rectangle
              Width="1"
              Height="1"
              Margin="55,12,24,37"
              Fill="#FFFFFF" />
            <Rectangle
              Width="1"
