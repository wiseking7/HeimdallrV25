<ResourceDictionary
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:cnvts="clr-namespace:Heimdallr.UI.Converters"
  xmlns:ctrls="clr-namespace:Heimdallr.UI.Controls">

  <Style TargetType="{x:Type ctrls:HeimdallrIcon}">
    <Setter Property="IconMouseOverFill" Value="#FF9DB2BF" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ctrls:HeimdallrIcon}">
          <Grid Background="{TemplateBinding Background}">

            <!--  Path용 Viewbox  -->
            <Viewbox
              x:Name="viewbox"
              Width="{TemplateBinding IconSize}"
              Height="{TemplateBinding IconSize}"
              Margin="2"
              Stretch="{TemplateBinding Stretch}"
              StretchDirection="Both"
              Visibility="Collapsed">
              <Path
                x:Name="iconPath"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Data="{TemplateBinding Data}">
                <Path.Fill>
                  <MultiBinding Converter="{cnvts:HeimdallrIconMouseOverConverter}">
                    <Binding Path="Fill" RelativeSource="{RelativeSource TemplatedParent}" />
                    <Binding Path="IconMouseOverFill" RelativeSource="{RelativeSource TemplatedParent}" />
                    <Binding Path="IsMouseOver" RelativeSource="{RelativeSource TemplatedParent}" />
                  </MultiBinding>
                </Path.Fill>
              </Path>
            </Viewbox>

            <!--  Image용 Viewbox  -->
            <Viewbox
              x:Name="imageViewbox"
              Width="{TemplateBinding IconSize}"
              Height="{TemplateBinding IconSize}"
              Margin="2"
              Stretch="{TemplateBinding Stretch}"
              StretchDirection="Both"
              Visibility="Collapsed">
              <Image
                x:Name="image"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                RenderOptions.BitmapScalingMode="HighQuality"
                SnapsToDevicePixels="True"
                Source="{TemplateBinding Source}"
                UseLayoutRounding="True" />
            </Viewbox>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="Mode" Value="Icon">
              <Setter TargetName="viewbox" Property="Visibility" Value="Visible" />
              <Setter TargetName="imageViewbox" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="Mode" Value="Image">
              <Setter TargetName="imageViewbox" Property="Visibility" Value="Visible" />
              <Setter TargetName="viewbox" Property="Visibility" Value="Collapsed" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>