<ResourceDictionary
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:cnvts="clr-namespace:Heimdallr.UI.Converters"
  xmlns:ctrls="clr-namespace:Heimdallr.UI.Controls">

  <cnvts:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

  <!--  다크 테마 대비 컬러  -->
  <SolidColorBrush x:Key="ProgressBarFillBrush" Color="#61AFEF" />
  <SolidColorBrush x:Key="ProgressBarTextBrush" Color="#ECEFF4" />
  <SolidColorBrush x:Key="ProgressBarBackgroundBrush" Color="#00000000" />
  <SolidColorBrush x:Key="ProgressBarIndeterminateBrush" Color="#56B6C2" />

  <!--  그라데이션 진행률 Brush  -->
  <LinearGradientBrush x:Key="ProgressBarFillGradient" StartPoint="0,0" EndPoint="1,0">
    <GradientStop Offset="0" Color="#61AFEF" />
    <GradientStop Offset="1" Color="#3FC1FF" />
  </LinearGradientBrush>

  <Style TargetType="{x:Type ctrls:HeimdallrProgressBar}">
    <!--  기본 크기 설정  -->
    <Setter Property="Height" Value="32" />
    <Setter Property="Width" Value="150" />
    <Setter Property="FontSize" Value="16" />

    <!--  텍스트 및 색상 설정  -->
    <Setter Property="Background" Value="{DynamicResource ProgressBarBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />

    <!--  사용자 선택 옵션 기본값  -->
    <Setter Property="IsProgressTextVisible" Value="True" />
    <Setter Property="ProgressTextForeground" Value="{DynamicResource ProgressBarTextBrush}" />
    <Setter Property="Fill" Value="{DynamicResource ProgressBarFillBrush}" />

    <!--  템플릿 설정  -->
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ctrls:HeimdallrProgressBar}">
          <!--  진행률만 채우기  -->
          <Border
            x:Name="MainBorder"
            Background="{DynamicResource ProgressBarBackgroundBrush}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            SnapsToDevicePixels="True"
            UseLayoutRounding="True">

            <!--  진행률 영역  -->
            <Grid Margin="2" ClipToBounds="True">
              <!--  Radius로 둥근 모서리 적용  -->
              <Border
                x:Name="PART_ProgressBar"
                HorizontalAlignment="Left"
                Background="{DynamicResource ProgressBarFillGradient}"
                SnapsToDevicePixels="True"
                UseLayoutRounding="True">

                <!--  RenderTransform 추가  -->
                <Border.RenderTransform>
                  <TranslateTransform x:Name="ProgressTranslateTransform" />
                </Border.RenderTransform>
              </Border>

              <!--  진행률 텍스트 StringFormat={}{0:0}%} 사용자 정의로 변경 가능  -->
              <TextBlock
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontWeight="Bold"
                Foreground="{TemplateBinding ProgressTextForeground}"
                IsHitTestVisible="False"
                Text="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, StringFormat={}{0:0}%}"
                Visibility="{Binding IsProgressTextVisible, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BooleanToVisibilityConverter}}" />

              <!--  인디터미넌트 상태 애니메이션  -->
              <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="ProgressStates">
                  <VisualState x:Name="Determinate" />
                  <VisualState x:Name="Indeterminate">
                    <Storyboard RepeatBehavior="Forever">
                      <DoubleAnimation
                        AutoReverse="False"
                        Storyboard.TargetName="PART_ProgressBar"
                        Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                        From="-50"
                        To="50"
                        Duration="0:0:1" />
                    </Storyboard>
                  </VisualState>
                </VisualStateGroup>
              </VisualStateManager.VisualStateGroups>
            </Grid>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
