<ResourceDictionary
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:ctrls="clr-namespace:Heimdallr.UI.Controls">

  <!--  달력 상단 Month 표시 스타일  -->
  <Style x:Key="MonthStyle" TargetType="{x:Type TextBlock}">
    <Setter Property="Text" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=CurrentMonth, StringFormat={}{0:yyyy년 MM월}}" />
    <Setter Property="Foreground" Value="#FFFFF8DE" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="Margin" Value="10,10,10,5" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>

  <!--  HeimdallrDatePicker 스타일  -->
  <Style TargetType="{x:Type ctrls:HeimdallrDatePicker}">
    <Setter Property="Background" Value="#FF234C6A" />
    <Setter Property="PopupBackground" Value="#FF456882" />
    <Setter Property="WatermarkForeground" Value="#FFF7E396" />
    <Setter Property="PopupAnimation" Value="Slide" />
    <Setter Property="VerticalOffset" Value="1" />
    <Setter Property="HorizontalOffset" Value="-1" />
    <Setter Property="Width" Value="140" />
    <Setter Property="Height" Value="35" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ctrls:HeimdallrDatePicker}">
          <Border
            x:Name="PART_RootBorder"
            Padding="4"
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            CornerRadius="4"
            SnapsToDevicePixels="True"
            UseLayoutRounding="True">
            <Grid>
              <!--  1. 날짜 입력 TextBox  -->
              <TextBox
                x:Name="PART_InputDate"
                Padding="4,0,30,0"
                VerticalContentAlignment="Center"
                Background="Transparent"
                BorderThickness="0"
                CaretBrush="#FFFFFFFF"
                Foreground="White" />

              <!--  2. 워터마크 TextBlock  -->
              <TextBlock
                x:Name="PART_InputDateWatermark"
                Margin="4,0,30,0"
                VerticalAlignment="Center"
                FontSize="15"
                Foreground="{TemplateBinding WatermarkForeground}"
                IsHitTestVisible="False"
                Opacity="0.5"
                Text="{TemplateBinding Watermark}" />

              <!--  3. 달력 열기 버튼  -->
              <ctrls:HeimdallrCalendarSwitch
                x:Name="PART_Switch"
                Width="24"
                Height="24"
                HorizontalAlignment="Right"
                VerticalAlignment="Center" />

              <!--  4. Popup 달력  -->
              <Popup
                x:Name="PART_Popup"
                AllowsTransparency="True"
                HorizontalOffset="{TemplateBinding HorizontalOffset}"
                Placement="Bottom"
                PlacementTarget="{Binding ElementName=PART_RootBorder}"
                PopupAnimation="{TemplateBinding PopupAnimation}"
                StaysOpen="False"
                VerticalOffset="{TemplateBinding VerticalOffset}">

                <Border
                  Padding="10"
                  Background="{TemplateBinding PopupBackground}"
                  CornerRadius="4">
                  <ctrls:HeimdallrGrid Columns="*" Rows="Auto,Auto,Auto">
                    <ctrls:HeimdallrGrid Columns="Auto,*,Auto" Rows="*">

                      <!--  날짜이동 왼쪽 아이콘  -->
                      <ctrls:HeimdallrChevronButton x:Name="PART_Left" Tag="Left" />

                      <TextBlock Style="{StaticResource MonthStyle}" />

                      <!--  날짜 이동 오른쪽 아이콘  -->
                      <ctrls:HeimdallrChevronButton x:Name="PART_Right" Tag="Right" />

                    </ctrls:HeimdallrGrid>

                    <UniformGrid Margin="0,4,0,0" Columns="7">
                      <ctrls:HeimdallrDayOfWeek Grid.Column="0" Content="월" />
                      <ctrls:HeimdallrDayOfWeek Grid.Column="1" Content="화" />
                      <ctrls:HeimdallrDayOfWeek Grid.Column="2" Content="수" />
                      <ctrls:HeimdallrDayOfWeek Grid.Column="3" Content="목" />
                      <ctrls:HeimdallrDayOfWeek Grid.Column="4" Content="금" />
                      <ctrls:HeimdallrDayOfWeek
                        Grid.Column="5"
                        Content="토"
                        Foreground="#FF9EC6F3" />
                      <ctrls:HeimdallrDayOfWeek
                        Grid.Column="6"
                        Content="일"
                        Foreground="#FFF08787" />
                    </UniformGrid>

                    <ctrls:HeimdallrCalendarBox x:Name="PART_ListBox" Margin="0,4,0,0" />
                  </ctrls:HeimdallrGrid>
                </Border>
              </Popup>
            </Grid>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>


