<ResourceDictionary
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:ctrls="clr-namespace:Heimdallr.UI.Controls">

  <Style BasedOn="{StaticResource {x:Type Button}}" TargetType="{x:Type ctrls:HeimdallrPulseEllipseButton}">
    <!--  기본적용  -->
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="UseLayoutRounding" Value="True" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="#FF333333" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="Width" Value="40" />
    <Setter Property="Height" Value="40" />

    <!--  커스텀 적용  -->
    <Setter Property="Icon" Value="None" />
    <Setter Property="IconSize" Value="13" />
    <Setter Property="IconFill" Value="#FF4A47A3" />
    <Setter Property="ShapeMode" Value="Free" />
    <Setter Property="Ellipse1Brush" Value="#FF577B8D" />
    <Setter Property="Ellipse2Brush" Value="#FF7A1CAC" />
    <Setter Property="Ellipse3Brush" Value="#FFB9B4C7" />

    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ctrls:HeimdallrPulseEllipseButton}">
          <Grid x:Name="RootGrid">
            <!--  바깥쪽 원  -->
            <Ellipse
              x:Name="ellipse1"
              Margin="0"
              Fill="{TemplateBinding Ellipse1Brush}" />
            <!--  중간 원  -->
            <Ellipse
              x:Name="ellipse2"
              Margin="5"
              Fill="{TemplateBinding Ellipse2Brush}" />
            <!--  안쪽 원  -->
            <Ellipse
              x:Name="ellipse3"
              Margin="10"
              Fill="{TemplateBinding Ellipse3Brush}" />

            <!--  ★ ellipse3 안쪽 영역 전용 Grid  -->
            <Grid
              x:Name="IconContainer"
              Margin="10"
              HorizontalAlignment="Center"
              VerticalAlignment="Center">

              <!--  아이콘을 ellipse3의 크기에 맞춰 정확히 중앙 정렬  -->
              <Viewbox
                Width="{TemplateBinding IconSize}"
                Height="{TemplateBinding IconSize}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Stretch="Uniform">
                <ctrls:HeimdallrIcon
                  x:Name="icon"
                  Fill="{TemplateBinding IconFill}"
                  Icon="{TemplateBinding Icon}"
                  IconMouseOverFill="{TemplateBinding IconMouseOverFill}" />
              </Viewbox>
            </Grid>
          </Grid>

          <!--  리소스: 클릭 애니메이션  -->
          <ControlTemplate.Resources>
            <Storyboard x:Key="ColorChangeStoryboard">
              <ColorAnimation
                AutoReverse="True"
                Storyboard.TargetName="ellipse1"
                Storyboard.TargetProperty="(Shape.Fill).(SolidColorBrush.Color)"
                To="Orange"
                Duration="0:0:0.3" />
              <ColorAnimation
                AutoReverse="True"
                Storyboard.TargetName="ellipse2"
                Storyboard.TargetProperty="(Shape.Fill).(SolidColorBrush.Color)"
                To="Teal"
                Duration="0:0:0.3" />
              <ColorAnimation
                AutoReverse="True"
                Storyboard.TargetName="ellipse3"
                Storyboard.TargetProperty="(Shape.Fill).(SolidColorBrush.Color)"
                To="Tomato"
                Duration="0:0:0.3" />
            </Storyboard>
          </ControlTemplate.Resources>

          <!--  트리거들  -->
          <ControlTemplate.Triggers>
            <!--  클릭 시 애니메이션  -->
            <EventTrigger RoutedEvent="Button.Click">
              <BeginStoryboard Storyboard="{StaticResource ColorChangeStoryboard}" />
            </EventTrigger>

            <!--  마우스 오버 시 Glow 효과  -->
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="ellipse1" Property="Effect">
                <Setter.Value>
                  <DropShadowEffect
                    BlurRadius="10"
                    ShadowDepth="0"
                    Color="#FF3DC2EC" />
                </Setter.Value>
              </Setter>
              <Setter TargetName="ellipse2" Property="Effect">
                <Setter.Value>
                  <DropShadowEffect
                    BlurRadius="10"
                    ShadowDepth="0"
                    Color="#FFF2F7A1" />
                </Setter.Value>
              </Setter>
              <Setter TargetName="ellipse3" Property="Effect">
                <Setter.Value>
                  <DropShadowEffect
                    BlurRadius="10"
                    ShadowDepth="0"
                    Color="#FFF05941" />
                </Setter.Value>
              </Setter>
            </Trigger>

            <!--  눌렸을 때 축소  -->
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="RootGrid" Property="RenderTransform">
                <Setter.Value>
                  <ScaleTransform ScaleX="0.95" ScaleY="0.95" />
                </Setter.Value>
              </Setter>
              <Setter TargetName="RootGrid" Property="RenderTransformOrigin" Value="0.5,0.5" />
            </Trigger>

            <!--  포커스 시 강조선  -->
            <Trigger Property="IsFocused" Value="True">
              <Setter TargetName="ellipse1" Property="Effect">
                <Setter.Value>
                  <DropShadowEffect
                    BlurRadius="15"
                    ShadowDepth="0"
                    Color="DeepSkyBlue" />
                </Setter.Value>
              </Setter>
            </Trigger>

            <!--  ★ 핵심 : ShapeMode=Circle → Width=Height 강제  -->
            <Trigger Property="ShapeMode" Value="Circle">
              <Setter Property="Height" Value="{Binding Width, RelativeSource={RelativeSource TemplatedParent}}" />
            </Trigger>

            <!--  IsEnable  -->
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Cursor" Value="Arrow" />
              <Setter TargetName="RootGrid" Property="Opacity" Value="0.6" />
              <Setter TargetName="icon" Property="Opacity" Value="0.6" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>