<ResourceDictionary
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:anim="clr-namespace:Heimdallr.UI.Extensions"
  xmlns:ctrls="clr-namespace:Heimdallr.UI.Controls">

  <Style BasedOn="{StaticResource {x:Type Button}}" TargetType="{x:Type ctrls:HeimdallrHoldButton}">
    <!--  기본 속성  -->
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Width" Value="120" />
    <Setter Property="Height" Value="34" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="Foreground" Value="#FF333333" />

    <!--  커스텀 속성  -->
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="HoldDuration" Value="0:0:0.1" />
    <Setter Property="AnimatedFillDuration" Value="0:0:0.3" />
    <Setter Property="IconFill" Value="#FFFFFFFF" />
    <Setter Property="BackgroundRectangleFill" Value="#FF1E3E62" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="MouseOverBackground" Value="#FFEBD5AB" />
    <Setter Property="PressedBackground" Value="#FF5C3E94" />
    <Setter Property="KeyboardFocusBorderBrush" Value="#FFE0D9D9" />
    <Setter Property="KeyboardFocusBorderThickness" Value="2" />
    <Setter Property="OneHoldFill" Value="#FFC62300" />
    <Setter Property="TwoHoldFill" Value="#FFF2F7A1" />
    <Setter Property="ThreeHoldFill" Value="#FF6D67E4" />

    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ctrls:HeimdallrHoldButton}">
          <Grid>
            <!--  기본 배경  -->
            <Border
              x:Name="BaseRect"
              Width="{TemplateBinding Width}"
              Height="{TemplateBinding Height}"
              Panel.ZIndex="2"
              anim:AnimationExtensions.AnimatedFill="{TemplateBinding Background}"
              anim:AnimationExtensions.AnimatedFillDuration="{TemplateBinding anim:AnimationExtensions.AnimatedFillDuration}"
              Background="{TemplateBinding Background}"
              BorderThickness="0"
              CornerRadius="{TemplateBinding CornerRadius}" />

            <!--  배경 확대용  -->
            <Border
              x:Name="BgRect"
              Width="{TemplateBinding Width}"
              Height="{TemplateBinding Height}"
              Panel.ZIndex="3"
              anim:AnimationExtensions.AnimatedFill="{TemplateBinding BackgroundRectangleFill}"
              anim:AnimationExtensions.AnimatedFillDuration="{TemplateBinding anim:AnimationExtensions.AnimatedFillDuration}"
              Background="{TemplateBinding BackgroundRectangleFill}"
              CornerRadius="{TemplateBinding CornerRadius}"
              Opacity="0.5" />

            <!--  Hold 진행용  -->
            <Border
              x:Name="HoldRect"
              Width="0"
              Height="0"
              Panel.ZIndex="4"
              anim:AnimationExtensions.AnimatedFill="{TemplateBinding OneHoldFill}"
              anim:AnimationExtensions.AnimatedFillDuration="{TemplateBinding anim:AnimationExtensions.AnimatedFillDuration}"
              Background="{TemplateBinding OneHoldFill}"
              CornerRadius="{TemplateBinding CornerRadius}"
              Opacity="0.7" />

            <!--  아이콘 + Content + 텍스트  -->
            <Grid
              Margin="3"
              VerticalAlignment="Center"
              Panel.ZIndex="5">
              <Grid.ColumnDefinitions>
                <!--  아이콘  -->
                <ColumnDefinition Width="Auto" />
                <!--  ButtonText  -->
                <ColumnDefinition Width="*" />
                <!--  ContentPresenter  -->
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>

              <!--  아이콘  -->
              <Viewbox
                Grid.Column="0"
                Width="{TemplateBinding IconSize}"
                Height="{TemplateBinding IconSize}"
                Stretch="Uniform">
                <ctrls:HeimdallrIcon
                  x:Name="IconElement"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  anim:AnimationExtensions.AnimatedFill="{TemplateBinding IconFill}"
                  anim:AnimationExtensions.AnimatedFillDuration="{TemplateBinding anim:AnimationExtensions.AnimatedFillDuration}"
                  Fill="{TemplateBinding IconFill}"
                  Icon="{TemplateBinding Icon}"
                  IconMouseOverFill="{TemplateBinding IconMouseOverFill}" />
              </Viewbox>

              <!--  ButtonText  -->
              <TextBlock
                Grid.Column="1"
                Margin="5,0,0,0"
                VerticalAlignment="Center"
                FontWeight="SemiBold"
                Foreground="{TemplateBinding Foreground}"
                Text="{TemplateBinding ButtonText}"
                TextTrimming="CharacterEllipsis"
                TextWrapping="NoWrap" />

              <!--  ContentPresenter  -->
              <ContentPresenter
                Grid.Column="2"
                Margin="5,0,0,0"
                VerticalAlignment="Center"
                Content="{TemplateBinding Content}" />
            </Grid>
          </Grid>

          <!--  애니메이션 트리거  -->
          <ControlTemplate.Triggers>
            <!--  마우스 오버  -->
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="BaseRect" Property="anim:AnimationExtensions.AnimatedFill" Value="{Binding MouseOverBackground, RelativeSource={RelativeSource TemplatedParent}}" />
              <Setter TargetName="IconElement" Property="anim:AnimationExtensions.AnimatedFill" Value="{Binding PressedBackground, RelativeSource={RelativeSource TemplatedParent}}" />
            </Trigger>

            <!--  클릭 상태  -->
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="BaseRect" Property="anim:AnimationExtensions.AnimatedFill" Value="{Binding PressedBackground, RelativeSource={RelativeSource TemplatedParent}}" />
              <Setter TargetName="IconElement" Property="anim:AnimationExtensions.AnimatedFill" Value="{Binding MouseOverBackground, RelativeSource={RelativeSource TemplatedParent}}" />
            </Trigger>

            <!--  키보드 포커스  -->
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="BaseRect" Property="anim:AnimationExtensions.AnimatedFill" Value="{Binding KeyboardFocusBorderBrush, RelativeSource={RelativeSource TemplatedParent}}" />
            </Trigger>

            <!--  비활성화  -->
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="BaseRect" Property="anim:AnimationExtensions.AnimatedFill" Value="Gray" />
              <Setter Property="Foreground" Value="LightGray" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>